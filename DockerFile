# Use official Python image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
# Set work directory
WORKDIR /app

# Install system dependencies (needed for some packages like psycopg2, pypdf, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*


# Install uv itself
RUN pip install --no-cache-dir uv 

# Install deps first (separate layer -- cached unless pyproject.toml/uv.lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev


# Copy project
COPY medical_agent/app ./app

# Expose port
EXPOSE 8000

# Run uvicorn
CMD ["uv", "run", "uvicorn", "app.medical_agent.main:app", "--host", "0.0.0.0", "--port", "8000"]
