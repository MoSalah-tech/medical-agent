# Required
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AI...
DATABASE_URL_PSYCOPG=postgresql://postgres:password@db.project.supabase.co:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@db.project.supabase.co:5432/postgres
SECRET_KEY=your_generated_secret_key

# Optional
LLM_PROVIDER=groq
GROQ_LLM_MODEL=openai/gpt-oss-120b
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_STT_MODEL=whisper-large-v3
PGVECTOR_COLLECTION=medical_documents
RETRIEVAL_TOP_K=5
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com